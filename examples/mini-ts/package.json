{
    "name": "mini-ts",
    "version": "1.0.0",
    "description": "A TypeScript compiler that uses gaia-frontend-wasm32",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "dev": "ts-node src/index.ts"
    },
    "keywords": [
        "typescript",
        "compiler",
        "gaia",
        "wasm32"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@nyar/gaia-assembler-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "typescript": "^5.0.0",
        "ts-node": "^10.9.0",
        "vitest": "^2.1.8",
        "@vitest/ui": "^2.1.8",
        "@vitest/coverage-v8": "^2.1.8"
    }
}